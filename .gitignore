# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Round-trip runs. The run root lives OUTSIDE the repo by default
# (feature-roundtrip-harness.md R3.1) — this line is belt-and-braces for anyone who
# points ROUNDTRIP_RUNS_DIR back inside it.
roundtrip-runs/
# `.roundtrip-dryrun/` is the default; the glob covers the per-scenario dirs a dry run
# uses when both scenarios are driven in one session (`.roundtrip-dryrun-b/`).
.roundtrip-dryrun*/

# Test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
# Lighthouse writes ~1.2 MB of regenerable HTML+JSON per run; the SCORES are the
# evidence and they live in feature-launch-polish.md's Verification Log.
lighthouse/

# Environment / secrets
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
