{
  /*
   * The Playwright suite is the one place BOTH worlds are in scope: the spec body
   * runs in Node, but every `page.evaluate` callback is serialised and executed
   * inside the browser, so `window`, `localStorage` and `HTMLElement` are real
   * there. It gets its own project rather than adding DOM to tsconfig.node.json,
   * which covers the build/config files and has no business seeing browser globals.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Type safety */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["e2e/**/*.ts"]
}
